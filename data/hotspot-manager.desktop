[Desktop Entry]
Type=Application
Name=Hotspot Manager
GenericName=Wi-Fi Hotspot
Comment=Share Wi-Fi as a hotspot while staying connected
Exec=hotspot-manager
Icon=hotspot-manager
Terminal=false
Categories=Network;Utility;
Keywords=wifi;hotspot;tethering;access point;
StartupWMClass=hotspot-manager
Actions=on;off;qr;

[Desktop Action on]
Name=Turn hotspot on
Exec=hotspot-manager --on --no-wait

[Desktop Action off]
Name=Turn hotspot off
Exec=hotspot-manager --off --no-wait

[Desktop Action qr]
Name=Show QR code
Exec=hotspot-manager --qr
