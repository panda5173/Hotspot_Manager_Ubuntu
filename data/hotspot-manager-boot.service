[Unit]
Description=Hotspot Manager boot guard (free the Wi-Fi radio for NetworkManager)
After=NetworkManager.service
Before=network-online.target create_ap.service display-manager.service
Wants=NetworkManager.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/lib/hotspot-manager/hsctl boot
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
