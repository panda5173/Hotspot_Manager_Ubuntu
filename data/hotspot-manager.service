[Unit]
Description=Hotspot Manager (create_ap supervisor)
After=network.target NetworkManager.service
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/lib/hotspot-manager/hsctl run
ExecStopPost=/usr/bin/python3 /usr/lib/hotspot-manager/hsctl cleanup
KillMode=mixed
TimeoutStopSec=25
Restart=no
