def wifi_ifaces():
    try:
        return sorted(n for n in os.listdir("/sys/class/net")
                      if os.path.exists(f"/sys/class/net/{n}/phy80211") and not n.startswith("ap"))
    except OSError:
        return []


def all_ifaces():
    try:
        return sorted(n for n in os.listdir("/sys/class/net") if n not in ("lo", "hsm-ifb0"))
    except OSError:
        return []


def saved_wifi_networks():
    try:
        out = subprocess.run(["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show"],
                             capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return []
    res = []
    for line in out.splitlines():
        name, _, typ = line.rpartition(":")
        if typ == "802-11-wireless" and name:
            res.append(name.replace("\\:", ":").replace("\\\\", "\\"))
    return sorted(set(res), key=str.lower)


def sta_link(iface):
    info = {"connected": False, "ssid": "", "channel": None}
    if not iface:
        return info
    try:
        out = subprocess.run(["iw", "dev", iface, "link"], capture_output=True, text=True, timeout=3).stdout
    except Exception:
        return info
    if out.startswith("Connected"):
        info["connected"] = True
        for line in out.splitlines():
            s = line.strip()
            if s.startswith("SSID:"):
                info["ssid"] = s[5:].strip()
            elif s.startswith("freq:"):
                try:
                    f = int(float(s[5:]))
                    info["channel"] = 14 if f == 2484 else ((f - 2407) // 5 if f < 3000 else (f - 5000) // 5)
                except ValueError:
                    pass
    return info


def nm_connecting(iface):
    try:
        out = subprocess.run(["nmcli", "-g", "GENERAL.STATE", "device", "show", iface],
                             capture_output=True, text=True, timeout=3).stdout
        m = re.match(r"(\d+)", out.strip())
        return bool(m) and 40 <= int(m.group(1)) < 100
    except Exception:
        return False


def internet_ok():
    for host in (("1.1.1.1", 53), ("8.8.8.8", 53)):
        try:
            socket.create_connection(host, timeout=3).close()
            return True
        except OSError:
            continue
    return False


def describe_main(m, inet=None):
    if not m or not m.get("connected"):
        return "Not connected"
    ch = m.get("channel")
    band = "" if not ch else (" · 5 GHz" if ch > 14 else " · 2.4 GHz")
    s = f"{m.get('ssid') or '?'}" + (f" · ch {ch}{band}" if ch else "")
    if inet is True:
        s += "  ·  ✓ Internet"
    elif inet is False:
        s += "  ·  ✗ No internet"
    return s


def run_helper(args, stdin=None, cb=None):
    def work():
        res = helper_call(args, stdin)
        if cb:
            GLib.idle_add(cb, *res)
    threading.Thread(target=work, daemon=True).start()


