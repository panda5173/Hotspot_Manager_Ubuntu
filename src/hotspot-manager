def wifi_qr_text(ssid, pw, hidden):
    esc = lambda s: re.sub(r'([\\;,:"])', r"\\\1", s)
    return f"WIFI:T:WPA;S:{esc(ssid)};P:{esc(pw)};" + ("H:true;" if hidden else "") + ";"


def qr_pixbuf(text, size=260):
    png = None
    try:
        p = subprocess.run(["qrencode", "-t", "PNG", "-s", "8", "-m", "2", "-o", "-"],
                           input=text.encode(), capture_output=True, timeout=5)
        if p.returncode == 0:
            png = p.stdout
    except (FileNotFoundError, subprocess.TimeoutExpired):
        pass
    if png is None:
        try:
            import io
            import qrcode
            buf = io.BytesIO()
            qrcode.make(text, border=2).save(buf, format="PNG")
            png = buf.getvalue()
        except Exception:
            return None
    loader = GdkPixbuf.PixbufLoader.new_with_type("png")
    loader.write(png)
    loader.close()
    return loader.get_pixbuf().scale_simple(size, size, GdkPixbuf.InterpType.NEAREST)


def norm_mac(t):
    t = t.strip().lower().replace("-", ":")
    if re.fullmatch(r"[0-9a-f]{12}", t):
        t = ":".join(t[i:i + 2] for i in range(0, 12, 2))
    return t if MAC_RE.match(t) else None


def norm_entry(t):
    """'https://www.Example.com/path' -> 'example.com'; IPv4 / CIDR kept. '' = skip, None = invalid."""
    t = t.strip().lower()
    if not t or t.startswith("#"):
        return ""
    if re.fullmatch(r"[0-9.]+(/\d{1,2})?", t):
        try:
            return str(ipaddress.IPv4Network(t, strict=False)) if "/" in t else str(ipaddress.IPv4Address(t))
        except ValueError:
            return None
    t = re.sub(r"^[a-z][a-z0-9+.-]*://", "", t).split("/")[0].split("?")[0].split(":")[0].strip(".")
    if t.startswith("*."):
        t = t[2:]
    if t.startswith("www."):
        t = t[4:]
    return t if DOMAIN_RE.match(t) else None


def label(text="", css=(), xalign=0.0, wrap=False, select=False):
    l = Gtk.Label(label=text, xalign=xalign)
    for c in css:
        l.get_style_context().add_class(c)
    if wrap:
        l.set_line_wrap(True)
        l.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
        l.set_max_width_chars(1)           # let the label shrink to the window instead of widening it
        l.set_hexpand(True)
    l.set_selectable(select)
    return l


