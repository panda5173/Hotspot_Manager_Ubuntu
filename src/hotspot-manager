    def fill_lists(self):
        for box, key, chip, chip_cls, btn, fn in (
                (self.blk_list, "blocked", "BLOCKED", "chip-red", "Unblock", self.unblock),
                (self.alw_list, "allowed", "APPROVED", "chip-green", "Remove", self.unapprove)):
