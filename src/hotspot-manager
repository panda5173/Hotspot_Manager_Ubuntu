                r.pack_start(label(f"{nm}  ·  {d['mac']}", select=True), True, True, 0)
                r.pack_end(small_btn(btn, lambda _b, m=d["mac"], f=fn: f(m)), False, False, 0)
                box.pack_start(r, False, False, 0)
            box.show_all()
        self.dev_sig = None
        self.rej_sig = None

    def push_config(self, part, msg_lbl, ok_text, after=None):
        msg_lbl.set_text("Applying…")

        def done(rc, out, err):
            if rc != 0:
                msg_lbl.set_text(err or "Could not save.")
                return
            self.cfg.update(part)
            msg_lbl.set_text(ok_text)
            self.fill_lists()
            if after:
                after()
        run_helper(["set-config"], stdin=json.dumps(part), cb=done)

    def entry(self, mac, host=""):
        return {"mac": mac, "name": (self.prefs["nicknames"].get(mac) or host or "")[:64]}

    def block(self, mac, host=""):
        bl = [d for d in self.cfg.get("blocked", []) if d["mac"] != mac] + [self.entry(mac, host)]
        al = [d for d in self.cfg.get("allowed", []) if d["mac"] != mac]
        self.push_config({"blocked": bl, "allowed": al}, self.ctl_msg, f"Blocked {self.dname(mac, host)}.")

    def unblock(self, mac):
        bl = [d for d in self.cfg.get("blocked", []) if d["mac"] != mac]
        self.push_config({"blocked": bl}, self.ctl_msg, f"Unblocked {self.dname(mac)}.")

    def approve(self, mac, host="", msg=None):
        al = [d for d in self.cfg.get("allowed", []) if d["mac"] != mac] + [self.entry(mac, host)]
        bl = [d for d in self.cfg.get("blocked", []) if d["mac"] != mac]
        self.push_config({"allowed": al, "blocked": bl}, msg or self.ctl_msg, f"Approved {self.dname(mac, host)}.")

    def unapprove(self, mac):
        al = [d for d in self.cfg.get("allowed", []) if d["mac"] != mac]
        self.push_config({"allowed": al}, self.ctl_msg, f"Removed {self.dname(mac)} from the allow-list.")

    def mac_entry(self, e, fn):
        m = norm_mac(e.get_text())
        if not m:
            self.ctl_msg.set_text("Enter a valid MAC address, e.g. aa:bb:cc:dd:ee:ff")
            return
        e.set_text("")
        fn(m)

    def on_allow_mode(self, sw, state):
        part = {"allow_mode": state}
        txt = "Allow-list is OFF: any device with the password can connect."
        if state:
            al = list(self.cfg.get("allowed", []))
            have = {d["mac"] for d in al}
            cl = self.status.get("clients", []) if self.status.get("state") == "running" else []
            added = [self.entry(c["mac"], c.get("name", "")) for c in cl if c["mac"] not in have]
            part["allowed"] = al + added
            txt = "Allow-list is ON" + (f": approved {len(added)} connected device(s)." if added else ".")
            if not part["allowed"]:
                txt += " No devices are approved yet - nobody can connect."
        self.push_config(part, self.ctl_msg, txt, lambda: sw.set_state(state))
        return True

    def save_controls(self, *_):
        buf = self.t_block.get_buffer()
        entries, bad = [], []
        for line in buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False).splitlines():
            e = norm_entry(line)
            if e is None:
                bad.append(line.strip())
            elif e and e not in entries:
                entries.append(e)
        if bad:
            self.ctl_msg.set_text("Invalid entries: " + ", ".join(bad[:5]))
            return
        part = {"max_clients": int(self.s_max.get_value()), "idle_off": int(self.c_idle.get_active_id() or 0),
                "dl_total": round(self.s_dtot.get_value(), 1), "dl_per": round(self.s_dper.get_value(), 1),
                "ul_total": round(self.s_utot.get_value(), 1), "ul_per": round(self.s_uper.get_value(), 1),
                "blocklist": entries}
        live = "Applied." if self.state == "running" else "Saved. Applies when the hotspot starts."
        self.push_config(part, self.ctl_msg, live, lambda: buf.set_text("\n".join(entries)))

