    # ---- actions
    def auto_start(self):
        """Login auto-on. Never grab the radio before the main Wi-Fi had its chance to connect:
        - wait LOGIN_SETTLE seconds, and keep waiting while NetworkManager is connecting;
        - start as soon as main Wi-Fi is connected (hotspot then shares its channel);
        - without Wi-Fi: start hotspot-only only if the user enabled 'Run without internet after N min'
          (after max(N min, LOGIN_MIN_WAIT)); otherwise keep waiting for Wi-Fi."""
        if self.auto_cancel or self.state in ("running", "starting", "paused", "stopping") or self.pending:
            self.waiting_note = ""
            return False
        el = time.time() - self.login_t0
        iface = self.cfg.get("wifi_iface", "")
        sta = sta_link(iface)
        if el >= LOGIN_SETTLE and sta.get("connected"):
            self.waiting_note = ""
            self.request("start")
            return False
        fb = int(self.cfg.get("fallback_min", 0) or 0)
        if fb and el >= max(fb * 60, LOGIN_MIN_WAIT) and not nm_connecting(iface):
            self.waiting_note = ""
            self.request("start")
            return False
        self.waiting_note = ("Auto-on: waiting for main Wi-Fi to connect before starting the hotspot"
                             + (f" (hotspot-only after {fb} min)." if fb else "."))
        self.render()
        GLib.timeout_add_seconds(5, self.auto_start)
        return False

    def on_switch(self, sw, state):
        self.request("start" if state else "stop")
        return True

    def request(self, action):
        if action == "start" and not self.cfg.get("ssid"):
            self.show_window()
            self.stack.set_visible_child_name("settings")
            self.set_msg.set_text("Configure SSID and password first.")
            self.render()
            return
        self.auto_cancel = True                # any manual action cancels a pending login auto-on
        self.waiting_note = ""
        self.pending = (action, time.time())
        self.user_until = time.time() + 45
        self.sw.set_sensitive(False)
        self.render()

        def done(rc, out, err):
            if rc != 0:
                self.pending = None
                self.status = {"state": "error", "error": err or f"{action} failed"}
                self.sw.set_sensitive(True)
                self.render()
        run_helper([action], cb=done)

    def reset_usage(self, *_):
        d = Gtk.MessageDialog(transient_for=self.win, modal=True, message_type=Gtk.MessageType.QUESTION,
                              buttons=Gtk.ButtonsType.OK_CANCEL, text="Reset all usage history?")
        if d.run() == Gtk.ResponseType.OK:
            run_helper(["reset-usage"], cb=lambda *a: self.refresh_usage(force=True))
        d.destroy()

    def export_csv(self, *_):
        d = Gtk.FileChooserDialog(title="Export usage", transient_for=self.win,
                                  action=Gtk.FileChooserAction.SAVE)
        d.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Save", Gtk.ResponseType.ACCEPT)
        d.set_do_overwrite_confirmation(True)
        d.set_current_name(f"hotspot-usage-{datetime.date.today().isoformat()}.csv")
        dl = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOWNLOAD)
        if dl:
            d.set_current_folder(dl)
        if d.run() == Gtk.ResponseType.ACCEPT:
            days = self.usage.get("days", {})
            with open(d.get_filename(), "w") as f:
                f.write("date,to_devices_bytes,from_devices_bytes,total_bytes,online_seconds,peak_devices\n")
                for k in sorted(days):
                    e = days[k]
                    f.write(f"{k},{e['tx']},{e['rx']},{e['tx'] + e['rx']},{int(e['seconds'])},{e['peak_clients']}\n")
        d.destroy()

    # ---- refresh loop
    def gui_inet_check(self):
        if self.inet_busy or not self.win.get_visible() or self.state in ("running", "paused"):
            return True
        self.inet_busy = True

        def work():
            ok = internet_ok() if sta_link(self.cfg.get("wifi_iface", "")).get("connected") else None

            def fin():
                self.inet_gui, self.inet_busy = ok, False
            GLib.idle_add(fin)
        threading.Thread(target=work, daemon=True).start()
        return True

    def tick(self):
        self.status = read_status()
        self.render()
        return True

    def notify_events(self, st):
        real = st.get("state", "stopped")
        p = self.prefs
        ssid = self.cfg.get("ssid", "hotspot")
        if real == "running":
            cl = {c["mac"]: c for c in st.get("clients", [])}
            if self.known is not None and p["notify_devices"]:
                for m in cl.keys() - self.known.keys():
                    notify("Device connected", f"{self.dname(m, cl[m].get('name'))} joined {ssid}")
                for m in self.known.keys() - cl.keys():
                    notify("Device disconnected", f"{self.dname(m, self.known[m].get('name'))} left {ssid}")
            self.known = cl
            lim = set(st.get("limited", []))
            rej = {r["mac"] for r in st.get("rejected", [])}
            if p["notify_limits"]:
                for m in lim - self.lim_seen:
                    notify("Device limit reached",
                           f"{self.dname(m)} was turned away (max {self.cfg.get('max_clients')} devices).")
                for m in rej - self.rej_seen:
                    notify("Unknown device rejected",
                           f"{self.dname(m)} is not on the allow-list. Approve it in Controls.")
            self.lim_seen, self.rej_seen = lim, rej
        elif real != "starting":
            self.known = None
        prev = self.real_prev
        self.real_prev = real
        if prev is None or prev == real or not p["notify_state"] or time.time() < self.user_until:
            return
        if real == "paused":
            notify("Hotspot paused", st.get("reason") or "Waiting for main Wi-Fi.")
        elif real == "running" and prev in ("paused", "starting", "error"):
            notify("Hotspot running" if prev != "paused" else "Hotspot resumed",
                   "Running without internet (main Wi-Fi unavailable)." if st.get("standalone")
                   else f"{ssid} is back online.")
        elif real == "stopped" and st.get("reason"):
            notify("Hotspot turned off", st["reason"])
        elif real == "error":
            notify("Hotspot failed", (st.get("error") or "").splitlines()[0] if st.get("error") else "")
        elif real == "starting" and st.get("reason"):
            notify("Hotspot recovering", st["reason"])

    def render(self):
        st = self.status
        self.notify_events(st)
        state = st.get("state", "stopped")
        if self.pending:
            act, t = self.pending
            done = ((act in ("start", "restart") and state in ("running", "error", "paused")
                     and st.get("updated", 0) > t)
                    or (act == "stop" and state in ("stopped", "error")) or time.time() - t > 40)
            if done:
                self.pending = None
            else:
                state = "stopping" if act == "stop" else "starting"
        self.state = state
        self.sw.set_sensitive(self.pending is None)
        on = state in ("running", "starting", "paused")
        self.sw.handler_block(self.sw_h)
        self.sw.set_active(on)
        self.sw.set_state(on)
        self.sw.handler_unblock(self.sw_h)

        solo = state == "running" and st.get("standalone")
        clients = st.get("clients", []) if state == "running" else []
        text = {"running": "Running · no internet" if solo else "Running", "starting": "Starting…",
                "stopping": "Stopping…", "paused": "Paused · waiting for Wi-Fi", "error": "Failed to start",
                "stopped": "Waiting for Wi-Fi" if self.waiting_note else "Stopped"}.get(state, state)
        hero_cls = {"running": "hero-solo" if solo else "hero-on", "starting": "hero-wait",
                    "stopping": "hero-wait", "paused": "hero-wait", "error": "hero-err"}.get(state, "hero-off")
        set_classes(self.hero, ("hero-on", "hero-solo", "hero-off", "hero-wait", "hero-err"), hero_cls)
        self.state_lbl.set_text(text)
        sub = text + (f" · {len(clients)} device{'s' if len(clients) != 1 else ''}" if state == "running" else "")
        self.hb.set_subtitle(sub)
        note = st.get("error", "") if state == "error" else (st.get("reason") or "")
        if state == "stopped" and self.waiting_note:
            note = self.waiting_note
        if state == "stopping":
            note = ""
        self.note_lbl.set_text(note)
        self.note_lbl.set_visible(bool(note))

        self.refresh_usage()
        today = (self.usage.get("days", {}).get(datetime.date.today().isoformat()) or {})
        today_b = today.get("rx", 0) + today.get("tx", 0)
        if self.ind:
            icon = "hotspot-manager-on" if state == "running" else "hotspot-manager-off"
            if icon != self.tray_icon:
                self.ind.set_icon_full(icon, text)
                self.tray_icon = icon
            head = f"{self.cfg.get('ssid', 'Hotspot')}: {sub}"
            self.t_status.set_label(head)
            self.t_usage.set_label(f"Today: {fmt_bytes(today_b)}")
            self.ind.set_title(f"Hotspot Manager - {head} - today {fmt_bytes(today_b)}")
            self.t_toggle.set_label("Turn hotspot off" if on else "Turn hotspot on")
            self.t_toggle.set_sensitive(self.pending is None)

        if not self.win.get_visible():
            return
        rx, tx, upd = st.get("rx", 0), st.get("tx", 0), st.get("updated", 0)
        dn = up = 0
        if state == "running" and self.prev and upd > self.prev[0] and rx >= self.prev[1] and tx >= self.prev[2]:
            dt = upd - self.prev[0]
            up, dn = (rx - self.prev[1]) / dt, (tx - self.prev[2]) / dt
            self.rates = (dn, up)
        elif state == "running" and self.prev and upd == self.prev[0]:
            dn, up = self.rates
        self.prev = (upd, rx, tx) if state == "running" else None
        self.down_lbl.set_text(fmt_rate(dn))
        self.up_lbl.set_text(fmt_rate(up))
        if state == "running":
            self.v_session.set_text(f"{fmt_bytes(st.get('session_rx', 0) + st.get('session_tx', 0))}  "
                                    f"(↓ {fmt_bytes(st.get('session_tx', 0))}  ↑ {fmt_bytes(st.get('session_rx', 0))})")
            self.v_iface.set_text(f"{st.get('ap_iface', '')}  (on {st.get('wifi_iface', '')})")
            ch = st.get("channel")
            self.v_chan.set_text(f"{ch}  ({'5' if ch and ch > 14 else '2.4'} GHz)" if ch else "—")
            self.v_up.set_text(fmt_dur(time.time() - st["started_at"]) if st.get("started_at") else "—")
            main, inet = st.get("main", {}), st.get("internet")
        elif state == "paused":
            for v in (self.v_session, self.v_iface, self.v_chan, self.v_up):
                v.set_text("—")
            main, inet = st.get("main", {}), None
        else:
            for v in (self.v_session, self.v_iface, self.v_chan, self.v_up):
                v.set_text("—")
            t, main = self.main_cache
            if time.time() - t > 6:
                main = sta_link(self.cfg.get("wifi_iface", ""))
                self.main_cache = (time.time(), main)
            inet = self.inet_gui if main.get("connected") else None
        self.v_main.set_text(describe_main(main, inet))
        lim = st.get("limited", []) if state == "running" else []
        self.v_devs.set_text(f"{len(clients)}" + (f"  (rejected {len(lim)}: max reached)" if lim else ""))
        c = self.cfg
        left = st.get("idle_left") if state == "running" else None
        if not c.get("idle_off"):
            self.v_auto.set_text("Never")
        elif left is not None and not clients:
            self.v_auto.set_text(f"in {fmt_dur(max(0, left))} (no devices)")
        else:
            self.v_auto.set_text(f"After {c['idle_off']} min without devices")
        parts = []
        if c.get("allow_mode"):
            parts.append(f"allow-list ({len(c.get('allowed', []))})")
        if c.get("max_clients"):
            parts.append(f"max {c['max_clients']} devices")
        for k, s in (("dl_total", "↓ {} Mbps total"), ("dl_per", "↓ {} Mbps/device"),
                     ("ul_total", "↑ {} Mbps total"), ("ul_per", "↑ {} Mbps/device")):
            if c.get(k):
                parts.append(s.format(f"{c[k]:g}"))
        if c.get("blocked"):
            parts.append(f"{len(c['blocked'])} blocked")
        if c.get("blocklist"):
            parts.append(f"{len(c['blocklist'])} sites/IPs filtered")
        if st.get("warnings") and state == "running":
            parts.append("⚠ filter warning (see Log)")
        self.v_ctl.set_text(" · ".join(parts) or "None")
        self.v_ctl.set_tooltip_text(" · ".join(parts) or None)
        self.ssid_lbl.set_text(self.cfg.get("ssid") or "Not configured")

        pg = self.stack.get_visible_child_name()
        if pg == "devices":
            self.refresh_devices(clients)
        elif pg == "controls":
            self.refresh_rejected(st.get("rejected", []) if state == "running" else [])
        elif pg == "log":
            self.refresh_log()

    def refresh_devices(self, clients):
        sig = tuple((c.get("mac"), c.get("ip"), c.get("name"), c.get("rx"), c.get("tx")) for c in clients)
        if sig == self.dev_sig:
            return
        self.dev_sig = sig
        allowed = {d["mac"] for d in self.cfg.get("allowed", [])}
        clear(self.dev_list)
        for c in clients:
            mac, host = c["mac"], c.get("name", "")
            row = Gtk.Box(spacing=8, margin=8)
            row.pack_start(label("●", ("dot", "okc")), False, False, 0)
            r = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            nick = self.prefs["nicknames"].get(mac)
            r.pack_start(label(nick or host or "Unknown device", ("h2",)), False, False, 0)
            r.pack_start(label(f"{c.get('ip') or 'IP pending'}  ·  {mac}" + (f"  ·  {host}" if nick and host else ""),
                               ("dim", "small"), wrap=True, select=True), False, False, 0)
            r.pack_start(label(f"↓ {fmt_bytes(c.get('tx', 0))}  ↑ {fmt_bytes(c.get('rx', 0))}  ·  "
                               f"connected {fmt_dur(c.get('secs', 0))}", ("dim", "small"), wrap=True), False, False, 0)
            row.pack_start(r, True, True, 0)
            row.pack_end(small_btn("Block", lambda _b, m=mac, h=host: self.block(m, h), "destructive-action"),
                         False, False, 0)
            if mac in allowed:
                row.pack_end(label("APPROVED", ("chip", "chip-green")), False, False, 0)
            else:
                row.pack_end(small_btn("Approve", lambda _b, m=mac, h=host: self.approve(m, h, self.dev_msg)),
                             False, False, 0)
            row.pack_end(small_btn("Rename", lambda _b, m=mac, h=host: self.rename(m, h)), False, False, 0)
            self.dev_list.add(row)
        self.dev_list.show_all()

    def refresh_rejected(self, rej):
        sig = tuple(r["mac"] for r in rej)
        if sig == self.rej_sig:
            return
        self.rej_sig = sig
        clear(self.rej_list)
        self.rej_head.set_visible(bool(rej))
        for r in rej:
            row = Gtk.Box(spacing=8)
            row.pack_start(label("REJECTED", ("chip", "chip-red")), False, False, 0)
            when = datetime.datetime.fromtimestamp(r["t"]).strftime("%H:%M")
            row.pack_start(label(f"{self.dname(r['mac'])}  ·  last try {when}", select=True), True, True, 0)
            row.pack_end(small_btn("Allow", lambda _b, m=r["mac"]: self.approve(m)), False, False, 0)
            self.rej_list.pack_start(row, False, False, 0)
        self.rej_list.show_all()

    def refresh_usage(self, force=False):
        try:
            m = os.path.getmtime(USAGE)
        except OSError:
            m = -1
        if m != self.usage_mtime or force:
            self.usage_mtime = m
            self.usage = read_json(USAGE, {})
            self.usage_dirty = True
        if self.usage_dirty and (self.win.get_visible() or force):
            self.usage_dirty = False
            self.rebuild_usage()
        days = self.usage.get("days", {})
        t = days.get(datetime.date.today().isoformat())
        self.v_today.set_text(fmt_bytes(t["rx"] + t["tx"]) if t else "0 B")

    @staticmethod
    def bar_row(box, name, total, peak, sub):
        row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        h = Gtk.Box(spacing=8)
        n = label(name, ("h2",))
        n.set_ellipsize(Pango.EllipsizeMode.END)
        n.set_hexpand(True)
        h.pack_start(n, True, True, 0)
        h.pack_end(label(fmt_bytes(total), ("h2",)), False, False, 0)
        row.pack_start(h, False, False, 0)
        lb = Gtk.LevelBar(min_value=0, max_value=1)
        lb.set_value(total / peak if peak else 0)
        row.pack_start(lb, False, False, 0)
        row.pack_start(label(sub, ("dim", "small"), wrap=True), False, False, 0)
        box.pack_start(row, False, False, 0)

    def rebuild_usage(self):
        days = self.usage.get("days", {})
        today = datetime.date.today()
        tot = lambda e: e["rx"] + e["tx"]
        t = days.get(today.isoformat())
        self.u_today.set_text(fmt_bytes(tot(t)) if t else "0 B")
        self.u_today_sub.set_text(
            f"↓ {fmt_bytes(t['tx'])}  ↑ {fmt_bytes(t['rx'])}  ·  online {fmt_dur(t['seconds'])}  ·  "
            f"peak {t['peak_clients']} devices" if t else "No hotspot usage today")

        def span(n):
            keys = {(today - datetime.timedelta(days=i)).isoformat() for i in range(n)}
            return sum(tot(e) for k, e in days.items() if k in keys)
        self.u_7.set_text(fmt_bytes(span(7)))
        self.u_30.set_text(fmt_bytes(span(30)))
        ym = today.strftime("%Y-%m")
        self.u_month.set_text(fmt_bytes(sum(tot(e) for k, e in days.items() if k.startswith(ym))))
        self.u_all.set_text(fmt_bytes(sum(tot(e) for e in days.values())))

        clear(self.days_box)
        recent = [(k, days[k]) for k in sorted(days, reverse=True)
                  if k >= (today - datetime.timedelta(days=29)).isoformat()]
        peak = max([tot(e) for _, e in recent] + [1])
        if not recent:
            self.days_box.pack_start(label("No history yet", ("dim",)), False, False, 0)
        for k, e in recent:
            d = datetime.date.fromisoformat(k)
            name = "Today" if d == today else ("Yesterday" if d == today - datetime.timedelta(days=1)
                                                else d.strftime("%a, %d %b"))
            self.bar_row(self.days_box, name, tot(e), peak,
                         f"↓ {fmt_bytes(e['tx'])}  ↑ {fmt_bytes(e['rx'])}  ·  online {fmt_dur(e['seconds'])}"
                         f"  ·  peak {e['peak_clients']} devices")

        clear(self.months_box)
        months = {}
        for k, e in days.items():
            mm = months.setdefault(k[:7], {"rx": 0, "tx": 0, "seconds": 0, "peak_clients": 0, "days": 0})
            mm["rx"] += e["rx"]
            mm["tx"] += e["tx"]
            mm["seconds"] += e["seconds"]
            mm["peak_clients"] = max(mm["peak_clients"], e["peak_clients"])
            mm["days"] += 1
        mk = sorted(months, reverse=True)[:12]
        mpeak = max([tot(months[k]) for k in mk] + [1])
        if not mk:
            self.months_box.pack_start(label("No history yet", ("dim",)), False, False, 0)
        for k in mk:
            e = months[k]
            name = datetime.date.fromisoformat(k + "-01").strftime("%B %Y")
            avg = tot(e) / max(1, e["days"])
            self.bar_row(self.months_box, name + ("  (this month)" if k == ym else ""), tot(e), mpeak,
                         f"↓ {fmt_bytes(e['tx'])}  ↑ {fmt_bytes(e['rx'])}  ·  {e['days']} active day(s)  ·  "
                         f"avg {fmt_bytes(avg)}/day  ·  online {fmt_dur(e['seconds'])}")

        clear(self.sess_box)
        sess = list(reversed(self.usage.get("sessions", [])))[:15]
        if not sess:
            self.sess_box.pack_start(label("No sessions yet", ("dim",)), False, False, 0)
        for s in sess:
            st = datetime.datetime.fromtimestamp(s["start"])
            en = datetime.datetime.fromtimestamp(s["end"]) if s.get("end") else None
            h = Gtk.Box(spacing=8)
            when = label(f"{st.strftime('%d %b  %H:%M')} – {en.strftime('%H:%M') if en else '…'}")
            when.set_ellipsize(Pango.EllipsizeMode.END)
            when.set_hexpand(True)
            h.pack_start(when, True, True, 0)
            h.pack_end(label(f"{fmt_bytes(s['rx'] + s['tx'])} · {fmt_dur((s.get('end') or time.time()) - s['start'])}"
                             f" · {s.get('peak_clients', 0)} dev", ("chip",)), False, False, 0)
            self.sess_box.pack_start(h, False, False, 0)
        for bx in (self.days_box, self.months_box, self.sess_box):
            bx.show_all()

    def refresh_log(self):
        try:
            m = os.path.getmtime(LOG)
        except OSError:
            self.log_view.get_buffer().set_text("No log yet. Start the hotspot to see output.")
            return
        if m == self.log_mtime:
            return
        self.log_mtime = m
        try:
            with open(LOG, errors="replace") as f:
                text = "".join(f.readlines()[-300:])
        except OSError as e:
            text = str(e)
        self.log_view.get_buffer().set_text(text)
        adj = self.log_sc.get_vadjustment()
        GLib.idle_add(lambda: adj.set_value(adj.get_upper()) and False)


