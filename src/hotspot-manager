    # ---- config
    def load_config(self, first=False):
        def done(rc, out, err):
            if rc == 0:
                try:
                    self.cfg = json.loads(out)
                except ValueError:
                    self.cfg = {}
            self.fill_settings()
            self.fill_controls()
            if not self.cfg.get("ssid"):
                self.set_msg.set_text("Set up your hotspot and press Save.")
                self.stack.set_visible_child_name("settings")
            elif first and self.prefs["auto_on"] and read_status()["state"] not in ("running", "paused"):
                self.login_t0 = time.time()
                GLib.timeout_add_seconds(3, self.auto_start)
        run_helper(["get-config"], cb=done)

    def fill_settings(self):
        c = self.cfg
        self.e_ssid.set_text(c.get("ssid", ""))
        self.e_pw.set_text(c.get("password", ""))
        wl = wifi_ifaces()
        wsel = c.get("wifi_iface") or (wl[0] if wl else "")
        self.c_wifi.remove_all()
        for n in sorted(set(wl + ([wsel] if wsel else []))):
            self.c_wifi.append(n, n)
        self.c_wifi.set_active_id(wsel)
        self.c_inet.remove_all()
        self.c_inet.append("", "Same as Wi-Fi interface")
        for n in all_ifaces():
            self.c_inet.append(n, n)
        self.c_inet.set_active_id(c.get("inet_iface", "") or "")
        self.c_band.set_active_id(c.get("band", "auto"))
        self.k_hidden.set_active(bool(c.get("hidden")))
        self.k_iso.set_active(bool(c.get("isolate")))
        self.c_fallback.set_active_id(str(c.get("fallback_min", 0)))
        self.c_pref.remove_all()
        self.c_pref.append("", "None")
        pref = c.get("pref_net", "")
        for n in sorted(set(saved_wifi_networks() + ([pref] if pref else [])), key=str.lower):
            self.c_pref.append(n, n)
        self.c_pref.set_active_id(pref)
        self.ssid_lbl.set_text(c.get("ssid") or "Not configured")
        self.update_pw_label()

    def save_config(self, *_):
        new = {"ssid": self.e_ssid.get_text().strip(), "password": self.e_pw.get_text(),
               "wifi_iface": self.c_wifi.get_active_id() or "", "inet_iface": self.c_inet.get_active_id() or "",
               "band": self.c_band.get_active_id() or "auto",
               "hidden": self.k_hidden.get_active(), "isolate": self.k_iso.get_active(),
               "fallback_min": int(self.c_fallback.get_active_id() or 0),
               "pref_net": self.c_pref.get_active_id() or ""}
        if new["inet_iface"] == new["wifi_iface"]:
            new["inet_iface"] = ""
        need_restart = any(new[k] != self.cfg.get(k) for k in RESTART_KEYS)
        self.set_msg.set_text("Saving…")

        def done(rc, out, err):
            if rc != 0:
                self.set_msg.set_text(err or "Could not save settings.")
                return
            self.cfg.update(new)
            self.fill_settings()
            if need_restart and self.state in ("running", "starting", "paused"):
                self.set_msg.set_text("Saved. Restarting hotspot…")
                self.request("restart")
            else:
                self.set_msg.set_text("Saved.")
        run_helper(["set-config"], stdin=json.dumps(new), cb=done)

