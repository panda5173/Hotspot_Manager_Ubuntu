# ---------------------------------------------------------------- shared helpers (no GTK)
def read_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return default


def read_status():
    st = read_json(STATUS, {}) or {}
    if st.get("state") in ("starting", "running", "paused") and time.time() - st.get("updated", 0) > 15:
        st["state"] = "stopped"
    st.setdefault("state", "stopped")
    return st


def fmt_bytes(n):
    n = float(n or 0)
    for u in ("B", "KB", "MB", "GB"):
        if n < 1024:
            return f"{n:.0f} {u}" if u == "B" else f"{n:.1f} {u}"
        n /= 1024
    return f"{n:.2f} TB"


def fmt_rate(n):
    return fmt_bytes(n) + "/s"


def fmt_dur(s):
    s = int(s or 0)
    h, m = divmod(s // 60, 60)
    return f"{h}h {m:02d}m" if h else (f"{m}m {s % 60:02d}s" if m else f"{s}s")


def helper_call(args, stdin=None):
    """Run hsctl as root: passwordless sudo rule first, pkexec as fallback. -> (rc, out, err)"""
    res = (1, "", "Could not run helper")
    for pre in (["sudo", "-n"], ["pkexec"]):
        p = None
        try:
            p = subprocess.run(pre + [HSCTL] + args, input=stdin, capture_output=True, text=True, timeout=120)
            res = (p.returncode, p.stdout, p.stderr.strip())
        except FileNotFoundError:
            continue
        except subprocess.TimeoutExpired:
            res = (1, "", "Timed out")
        if pre[0] == "sudo" and p and p.returncode != 0 and "sudo:" in p.stderr:
            continue
        break
    return res


def today_usage():
    d = read_json(USAGE, {}).get("days", {}).get(datetime.date.today().isoformat())
    return (d["rx"] + d["tx"]) if d else 0


# ---------------------------------------------------------------- CLI
def cli(argv):
    if "-h" in argv or "--help" in argv:
        print(__doc__.strip())
        return 0
    st = read_status()
    if "--status" in argv:
        if "--json" in argv:
            st["today_bytes"] = today_usage()
            print(json.dumps(st, indent=1))
        else:
            print_status(st)
        return 0 if st["state"] in ("running", "paused") else 3
    if "--toggle" in argv:
        action = "stop" if st["state"] in ("running", "paused", "starting") else "start"
    else:
        action = {"--on": "start", "--off": "stop", "--restart": "restart"}[
            next(a for a in argv if a in ("--on", "--off", "--restart"))]
    t = time.time()
    rc, out, err = helper_call([action])
    if rc:
        print(f"Error: {err or action + ' failed'}", file=sys.stderr)
        return rc
    if "--no-wait" in argv:
        print(f"Requested: {action}")
        return 0
    want = ("stopped", "error") if action == "stop" else ("running", "paused", "error")
    while time.time() - t < 45:
        time.sleep(1)
        st = read_status()
        if st["state"] in want and (action == "stop" or st.get("updated", 0) > t + 1):
            break
    print_status(st)
    return 0 if st["state"] in (("stopped",) if action == "stop" else ("running", "paused")) else 1


def print_status(st):
    s = st["state"]
    line = f"Hotspot: {s}"
    if s == "running":
        line += f" · {st.get('ssid', '')} · {len(st.get('clients', []))} device(s)"
        if st.get("standalone"):
            line += " · hotspot-only (no internet)"
        elif st.get("internet") is False:
            line += " · no internet"
    print(line)
    m = st.get("main") or {}
    if s in ("running", "paused"):
        print("Main Wi-Fi: " + (f"{m.get('ssid')} (ch {m.get('channel')})" if m.get("connected") else "not connected"))
    if st.get("reason"):
        print(st["reason"])
    if s == "error" and st.get("error"):
        print(st["error"])
    print(f"Today: {fmt_bytes(today_usage())}")


CLI_FLAGS = ("--on", "--off", "--toggle", "--restart", "--status", "-h", "--help")
if __name__ == "__main__" and any(a in CLI_FLAGS for a in sys.argv[1:]):
    sys.exit(cli(sys.argv[1:]))

