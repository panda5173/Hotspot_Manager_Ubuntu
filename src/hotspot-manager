# ---------------------------------------------------------------- application
class HotspotApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.win = None
        self.ind = None
        self.cfg = {}
        self.prefs = dict(PREF_DEFAULTS)
        self.prefs.update(read_json(PREFS, {}))
        if not isinstance(self.prefs.get("nicknames"), dict):
            self.prefs["nicknames"] = {}
        self.state = "stopped"
        self.pending = None
        self.prev = None
        self.rates = (0, 0)
        self.status = {}
        self.usage_mtime = 0
        self.usage = {}
        self.usage_dirty = True
        self.main_cache = (0, {})
        self.inet_gui = None
        self.inet_busy = False
        self.dev_sig = None
        self.rej_sig = None
        self.pw_visible = False
        self.tray_icon = None
        self.waiting_note = ""
        self.auto_cancel = False
        self.login_t0 = time.time()
        self.real_prev = None
        self.user_until = 0
        self.known = None
        self.lim_seen = set()
        self.rej_seen = set()

    # ---- lifecycle
    def do_startup(self):
        Gtk.Application.do_startup(self)
        prov = Gtk.CssProvider()
        prov.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.build_window()
        self.build_tray()
        if self.ind:
            self.hold()
        self.sync_autostart()
        self.load_config(first=True)
        self.tick()
        GLib.timeout_add_seconds(2, self.tick)
        GLib.timeout_add_seconds(15, self.gui_inet_check)

    def do_command_line(self, cl):
        args = cl.get_arguments()
        if "--qr" in args:
            self.show_qr()
        elif not ("--hidden" in args and self.ind):
            self.show_window()
        return 0

    def show_window(self, *_):
        self.win.show_all()
        self.note_lbl.set_visible(bool(self.note_lbl.get_text()))
        self.rej_head.set_visible(bool(self.rej_sig))
        self.win.present()
        self.tick()

    def on_delete(self, *_):
        if self.ind and self.prefs["close_to_tray"]:
            self.win.hide()
            return True
        self.quit()
        return False

    def save_prefs(self):
        os.makedirs(CFG_DIR, exist_ok=True)
        with open(PREFS, "w") as f:
            json.dump(self.prefs, f, indent=1)

    def sync_autostart(self):
        if self.prefs["start_at_login"]:
            os.makedirs(os.path.dirname(AUTOSTART), exist_ok=True)
            with open(AUTOSTART, "w") as f:
                f.write("[Desktop Entry]\nType=Application\nName=Hotspot Manager\n"
                        "Exec=hotspot-manager --hidden\nIcon=hotspot-manager\nTerminal=false\n"
                        "X-GNOME-Autostart-enabled=true\nX-GNOME-Autostart-Delay=10\n")
        elif os.path.exists(AUTOSTART):
            os.remove(AUTOSTART)

    def dname(self, mac, host=""):
        return self.prefs["nicknames"].get(mac) or host or mac

    # ---- window
    def build_window(self):
        w = self.win = Gtk.ApplicationWindow(application=self)
        w.set_default_size(580, 700)
        w.set_icon_name("hotspot-manager")
        w.get_style_context().add_class("hm")
        w.connect("delete-event", self.on_delete)

        hb = Gtk.HeaderBar(show_close_button=True, title="Hotspot Manager")
        self.hb = hb
        self.sw = Gtk.Switch(valign=Gtk.Align.CENTER, tooltip_text="Turn hotspot on/off")
        self.sw_h = self.sw.connect("state-set", self.on_switch)
        hb.pack_end(self.sw)
        w.set_titlebar(hb)

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, transition_duration=120)
        self.stack.connect("notify::visible-child-name", lambda *a: self.tick())
        sw = Gtk.StackSwitcher(stack=self.stack, halign=Gtk.Align.CENTER, margin_top=12, margin_bottom=12)
        sw.get_style_context().remove_class("linked")
        sw.get_style_context().add_class("tabs")
        vb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        vb.pack_start(sw, False, False, 0)
        vb.pack_start(self.stack, True, True, 0)
        w.add(vb)

        self.build_overview()
        self.build_devices()
        self.build_controls()
        self.build_usage()
        self.build_settings()
        self.build_log()

    def build_overview(self):
        sc, b = page()
        hero = self.hero = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        hero.get_style_context().add_class("hero")
        hero.get_style_context().add_class("hero-off")
